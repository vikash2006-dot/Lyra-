# ==============================================================================
# LYRA — Personal AI Operating System: Configuration Reference (.env)
# Copy this file to .env and adjust variables as desired.
# All settings are optional; LYRA starts with safe defaults and ₹0 requirements.
# ==============================================================================

# Core Application Settings
LYRA_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30.0

# Phase 3: Cloud AI Provider API Keys (Leave blank if not used)
# Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# xAI / Grok: https://x.ai/api
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# Groq Cloud: https://console.groq.com/
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/
OPENROUTER_API_KEY=

# Cerebras Cloud: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Anakin AI: https://anakin.ai/
ANAKIN_API_KEY=your_anakin_api_key_here
ANAKIN_APP_ID=your_anakin_app_id_here
ANAKIN_API_VERSION=2024-05-06
ANAKIN_APP_TYPE=quickapp

# Phase 4: Model Router & Multi-Provider Auto-Failover Configuration
# Preferred fallback order: gemini,xai,groq,cerebras,openrouter,anakin,ollama
LYRA_PROVIDER_ORDER=gemini,xai,groq,cerebras,openrouter,anakin,ollama
PROVIDER_PRIORITY=gemini,xai,groq,cerebras,openrouter,anakin,ollama
LYRA_PROVIDER_COOLDOWN_SECONDS=300.0
RATE_LIMIT_COOLDOWN_SECONDS=300.0

# Phase 7: Real-World Context Tools (Optional keys; default providers use zero keys)
# Tavily Search API (Optional free tier): https://tavily.com/
TAVILY_API_KEY=
NOMINATIM_USER_AGENT=LYRA-Personal-AI-OS/1.0

# Phase 8: Voice Interaction & Conversation Loop (₹0 Default; works out-of-the-box on macOS)
# STT provider: "free" (SpeechRecognition / Google Web Speech, ₹0 cost) or "mock"
STT_PROVIDER=free
# TTS provider: "system" (macOS say/afplay, ₹0 cost), "elevenlabs" (cloud API), or "mock"
TTS_PROVIDER=system
# Silence duration before considering user utterance complete (seconds)
VOICE_SILENCE_DURATION_SECONDS=1.2
# Overall timeout waiting for speech input per turn (seconds)
VOICE_INPUT_TIMEOUT_SECONDS=15.0
VOICE_TIMEOUT_SECONDS=15.0
# ElevenLabs API (Optional cloud voice tier): https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Phase 9: Memory Subsystem
MEMORY_DB_PATH=lyra_memory.db

# Phase 11: Authentication & User Identity
AUTH_DB_PATH=lyra_auth.db
AUTH_TOKEN_TTL_SECONDS=86400.0
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900.0

# Phase 12: Automation & Background Scheduling
AUTOMATION_DB_PATH=lyra_automation.db
AUTOMATION_POLL_INTERVAL_SECONDS=1.0
AUTOMATION_MAX_RETRIES=3

# Phase 13: Safe Browser Automation
BROWSER_HEADLESS=true
BROWSER_DOWNLOAD_DIR=downloads
BROWSER_MAX_DOWNLOAD_SIZE_BYTES=10485760
BROWSER_ALLOWED_DOMAINS=
BROWSER_BLOCKED_DOMAINS=169.254.169.254,metadata.google.internal
BROWSER_TIMEOUT_SECONDS=30.0
BROWSER_DRIVER_TYPE=auto

# Phase 14: Controlled Computer Interaction
COMPUTER_ENABLED=false
COMPUTER_ALLOW_APPS=Calculator,TextEdit,Notes,Finder
COMPUTER_BLOCKED_APPS=Terminal,iTerm,Console,System Settings,System Preferences,Disk Utility
COMPUTER_SCREENSHOT_DIR=screenshots
COMPUTER_REQUIRE_CONFIRMATION=true

# Phase 15: Offline & Local AI Runtime Mode (Optional local Ollama instance)
LYRA_OFFLINE_MODE=false
LOCAL_PROVIDER_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=llama3.2
LOCAL_MODEL_TIMEOUT_SECONDS=60.0
LOCAL_MODEL_AUTO_DISCOVER=true
